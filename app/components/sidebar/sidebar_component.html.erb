<div
  data-sidebar-target="sidebar"
  data-state="expanded"
  data-mobile-state="closed"
  data-collapsible="<%= @collapsible %>"
  data-variant="<%= @variant %>"
  data-side="<%= @side %>"
  class="group peer text-sidebar-foreground"
>
  <!-- Sidebar Gap (Desktop) -->
  <div
    class="hidden duration-200 relative h-svh w-[var(--sidebar-width)] bg-transparent transition-[width] ease-linear md:block
           group-data-[state=collapsed]:w-0
           group-data-[side=right]:rotate-180"
  ></div>

  <!-- Mobile Overlay Backdrop -->
  <div
    data-action="click->sidebar#closeMobile"
    class="fixed inset-0 z-20 hidden bg-black/50 transition-opacity duration-200 md:hidden
           group-data-[mobile-state=open]:block"
  ></div>

  <div
    class="duration-200 fixed inset-y-0 z-30 flex h-svh w-[var(--sidebar-width)] -translate-x-full transition-transform ease-linear
           group-data-[mobile-state=open]:translate-x-0
           group-data-[side=left]:left-0
           group-data-[side=right]:right-0
           group-data-[side=right]:translate-x-full
           group-data-[side=right]:group-data-[mobile-state=open]:translate-x-0
           md:z-10 md:translate-x-0 md:transition-[left,right,width]
           md:group-data-[state=collapsed]:group-data-[side=left]:-left-[var(--sidebar-width)]
           md:group-data-[state=collapsed]:group-data-[side=right]:-right-[var(--sidebar-width)]
           md:group-data-[state=collapsed]:group-data-[collapsible=icon]:w-[var(--sidebar-width-icon)]
           md:group-data-[state=collapsed]:group-data-[collapsible=icon]:left-0
           md:group-data-[state=collapsed]:group-data-[collapsible=icon]:right-0
           group-data-[variant=floating]:p-2
           group-data-[variant=inset]:p-2"
  >
    <div
      data-sidebar="sidebar"
      class="flex h-full w-full flex-col bg-sidebar border-sidebar-border group-data-[side=left]:border-r group-data-[side=right]:border-l group-data-[variant=floating]:rounded-xl group-data-[variant=floating]:border group-data-[variant=floating]:shadow group-data-[variant=inset]:rounded-xl group-data-[variant=inset]:border group-data-[variant=inset]:shadow"
    >
      <%= content %>
    </div>
  </div>
</div>
