<%= render CardComponent.new do |card| %>
  <% card.with_header do %>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="font-semibold leading-none tracking-tight">Congregações</h2>
        <p class="mt-1.5 text-sm text-muted-foreground">Unidades vinculadas à sede <%= @church.display_name_or_default %>.</p>
      </div>
      <button type="button"
              class="inline-flex cursor-pointer items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
              onclick="document.getElementById('modal-new-congregation').dispatchEvent(new CustomEvent('modal:open'))">
        <%= lucide_icon("plus", class: "mr-2 h-4 w-4") %> Adicionar congregação
      </button>
    </div>
  <% end %>

  <% if @congregations.empty? %>
    <p class="rounded-lg border border-dashed border-border/60 p-8 text-center text-sm text-muted-foreground">
      Nenhuma congregação vinculada.
    </p>
  <% else %>
    <div class="grid gap-3">
      <% @congregations.each do |congregation| %>
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border/60 p-4">
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-lg bg-primary/10 text-primary">
              <%= lucide_icon("church", class: "h-5 w-5") %>
            </span>
            <div>
              <div class="flex items-center gap-2">
                <p class="font-medium"><%= congregation.name %></p>
                <span class="inline-flex items-center rounded-full border border-border/60 px-2.5 py-0.5 text-xs">
                  <%= congregation.church_type_label %>
                </span>
              </div>
              <p class="text-xs text-muted-foreground">
                <%= congregation.city_with_state.presence || "Sem endereço" %> · Resp. <%= congregation.responsible_name.presence || "—" %>
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <%= settings_status_badge(congregation.status_active?) %>
            <%= button_to toggle_status_settings_congregation_path(congregation), method: :patch,
                  class: "inline-flex cursor-pointer items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground" do %>
              <%= lucide_icon("power", class: "h-3.5 w-3.5") %>
              <%= congregation.status_active? ? "Desativar" : "Ativar" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<!-- ── Modal: Nova congregação ─────────────────────────────────────────── -->
<%= render Shared::ModalComponent.new(
      id: "modal-new-congregation",
      title: "Nova congregação",
      description: "Vinculada a #{@church.display_name_or_default}.",
      size: :md
    ) do |modal| %>
  <% modal.with_body do %>
    <%= form_with url: settings_congregations_path, method: :post, scope: :congregation, local: true, class: "space-y-4" do |f| %>
      <div class="space-y-2">
        <label for="congregation_name" class="text-sm font-medium">Nome <span class="text-destructive">*</span></label>
        <%= f.text_field :name, id: "congregation_name", required: true,
              placeholder: "Ex.: Graça Aldeota", class: settings_input_classes %>
      </div>

      <div class="space-y-2">
        <span class="text-sm font-medium">Tipo</span>
        <div class="flex flex-wrap gap-2">
          <%= render Shared::RadioButtonComponent.new(
                name: "congregation[church_type]", value: "congregation",
                label: "Congregação", icon: "church", checked: true) %>
          <%= render Shared::RadioButtonComponent.new(
                name: "congregation[church_type]", value: "preaching_point",
                label: "Ponto de Pregação", icon: "map-pin") %>
        </div>
      </div>

      <div class="space-y-2">
        <span class="text-sm font-medium">Status</span>
        <div class="flex flex-wrap gap-2">
          <%= render Shared::RadioButtonComponent.new(
                name: "congregation[status]", value: "active",
                label: "Ativa", icon: "circle-check", checked: true) %>
          <%= render Shared::RadioButtonComponent.new(
                name: "congregation[status]", value: "inactive",
                label: "Inativa", icon: "power") %>
        </div>
      </div>

      <div class="grid grid-cols-[1fr_auto] gap-3">
        <div class="space-y-2">
          <label for="congregation_address_city" class="text-sm font-medium">Cidade</label>
          <input type="text" name="congregation[address_attributes][city]" id="congregation_address_city" class="<%= settings_input_classes %>">
        </div>
        <div class="space-y-2">
          <label for="congregation_address_state" class="text-sm font-medium">UF</label>
          <input type="text" name="congregation[address_attributes][state]" id="congregation_address_state" maxlength="2" class="<%= settings_input_classes("w-20") %>">
        </div>
      </div>

      <div class="space-y-2">
        <label for="congregation_responsible_name" class="text-sm font-medium">Responsável</label>
        <%= f.text_field :responsible_name, id: "congregation_responsible_name",
              placeholder: "Nome do líder", class: settings_input_classes %>
      </div>

      <div class="space-y-2">
        <label class="text-sm font-medium text-muted-foreground">Instituição pai</label>
        <input type="text" disabled value="<%= @church.display_name_or_default %>" class="<%= settings_input_classes("opacity-60") %>">
      </div>

      <div class="flex justify-end gap-3 border-t border-border/40 pt-4">
        <button type="button"
                class="inline-flex cursor-pointer items-center justify-center rounded-lg border border-border/60 bg-transparent px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-secondary"
                onclick="document.getElementById('modal-new-congregation').dispatchEvent(new CustomEvent('modal:close'))">
          Cancelar
        </button>
        <%= f.submit "Adicionar",
              class: "inline-flex cursor-pointer items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90" %>
      </div>
    <% end %>
  <% end %>
<% end %>
