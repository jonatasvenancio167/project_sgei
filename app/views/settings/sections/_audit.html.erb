<%
  current_module = params[:module_key].to_s
  current_start  = params[:start_date].to_s
  current_end    = params[:end_date].to_s

  url_builder = ->(page:, per:) do
    painel_settings_path(section: "audit", module_key: current_module,
                         start_date: current_start, end_date: current_end,
                         page: page, per: per)
  end
%>

<%= render CardComponent.new do |card| %>
  <% card.with_title { "Auditoria" } %>
  <% card.with_description { "Histórico de ações realizadas por usuários." } %>

  <!-- ── Filters ─────────────────────────────────────────────────────── -->
  <%= form_with url: painel_settings_path, method: :get, local: true, id: "settings-audit-filters",
        class: "mb-4 flex flex-wrap items-end gap-3" do |f| %>
    <%= hidden_field_tag :section, "audit" %>

    <div class="space-y-1">
      <label class="text-xs font-medium">Módulo</label>
      <%= f.select :module_key,
            options_for_select(
              [["Todos", "all"]] + AuditLog::MODULES.map { |key, label| [label, key] },
              current_module.presence || "all"
            ),
            {}, class: settings_input_classes("w-[180px]") %>
    </div>

    <div class="space-y-1">
      <label class="text-xs font-medium">De</label>
      <%= f.date_field :start_date, value: current_start, class: settings_input_classes("w-[160px]") %>
    </div>

    <div class="space-y-1">
      <label class="text-xs font-medium">Até</label>
      <%= f.date_field :end_date, value: current_end, class: settings_input_classes("w-[160px]") %>
    </div>

    <button type="submit" class="hidden"></button>

    <div class="ml-auto text-xs text-muted-foreground">
      <%= @pagy.count %> registro(s)
    </div>
  <% end %>

  <script>
    (function() {
      var form = document.getElementById('settings-audit-filters');
      if (!form) return;
      form.querySelectorAll('select, input[type="date"]').forEach(function(field) {
        field.addEventListener('change', function() { form.submit(); });
      });
    })();
  </script>

  <!-- ── Table ───────────────────────────────────────────────────────── -->
  <div class="overflow-x-auto rounded-lg border border-border/60">
    <table class="w-full caption-bottom text-sm">
      <thead>
        <tr class="border-b border-border/60">
          <th class="h-10 w-[160px] px-4 text-left align-middle font-medium text-muted-foreground">Data / hora</th>
          <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Usuário</th>
          <th class="h-10 w-[160px] px-4 text-left align-middle font-medium text-muted-foreground">Módulo</th>
          <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Ação</th>
          <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground hidden md:table-cell">Detalhe</th>
        </tr>
      </thead>
      <tbody class="[&_tr:last-child]:border-0">
        <% if @audit_logs.empty? %>
          <tr>
            <td colspan="5">
              <div class="flex flex-col items-center gap-2 py-10 text-center text-sm text-muted-foreground">
                <%= lucide_icon("scroll-text", class: "h-6 w-6 opacity-50") %>
                Nenhum registro no período.
              </div>
            </td>
          </tr>
        <% else %>
          <% @audit_logs.each do |log| %>
            <tr class="border-b border-border/60 transition-colors hover:bg-muted/30">
              <td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">
                <%= log.created_at.strftime("%d/%m/%Y %H:%M") %>
              </td>
              <td class="px-4 py-3 font-medium"><%= log.user_name %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center rounded-full border border-border/60 px-2.5 py-0.5 text-xs">
                  <%= log.module_label %>
                </span>
              </td>
              <td class="px-4 py-3"><%= log.action %></td>
              <td class="hidden px-4 py-3 text-muted-foreground md:table-cell"><%= log.detail.presence || "—" %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- ── Pagination ──────────────────────────────────────────────────── -->
  <div class="mt-4 border-t border-border/60">
    <%= render Shared::PaginationComponent.new(
          current_page: @pagy.page,
          total_pages:  @pagy.pages,
          total_count:  @pagy.count,
          page_size:    @pagy.limit,
          url_builder:  url_builder,
          item_label:   { singular: "registro", plural: "registros" }
        ) %>
  </div>
<% end %>
