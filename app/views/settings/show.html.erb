<% content_for :title, "Configurações" %>

<div class="mx-auto max-w-7xl p-8 lg:p-12">
  <!-- Header -->
  <header>
    <p class="text-sm text-muted-foreground">Administração</p>
    <h1 class="mt-1 font-serif text-4xl">Configurações</h1>
    <p class="mt-1 text-sm text-muted-foreground">
      Ajustes gerais da instituição, acessos, permissões e integrações.
    </p>
  </header>

  <!-- Flash messages -->
  <% if notice.present? %>
    <div class="mt-4 flex items-center gap-3 rounded-xl border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-700 dark:text-green-400">
      <%= lucide_icon("circle-check", class: "h-4 w-4 shrink-0") %>
      <%= notice %>
    </div>
  <% end %>
  <% if alert.present? %>
    <div class="mt-4 flex items-center gap-3 rounded-xl border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive">
      <%= lucide_icon("circle-alert", class: "h-4 w-4 shrink-0") %>
      <%= alert %>
    </div>
  <% end %>

  <div class="mt-8 grid gap-6 md:grid-cols-[260px_1fr]">
    <%= render "settings/nav" %>

    <div class="min-w-0">
      <%= render "settings/sections/#{@section}" %>
    </div>
  </div>
</div>
