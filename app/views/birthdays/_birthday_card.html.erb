<%# person: Birthdays::UserDecorator %>
<%# locals: (person:) %>
<div class="flex items-center gap-4 rounded-2xl border bg-card p-4 transition-shadow <%= person.birthday_today? ? "border-primary/70" : "border-border/60" %>"
     style="box-shadow: var(--shadow-soft)">
  <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full text-sm font-medium text-foreground/80 <%= person.avatar_color %>">
    <%= person.initials.presence || "?" %>
  </span>

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2">
      <p class="truncate font-medium"><%= person.name %></p>
      <% if person.birthday_today? %>
        <span class="inline-flex items-center gap-1 rounded-full bg-primary px-2.5 py-0.5 text-xs font-semibold text-primary-foreground">
          🎂 Hoje!
        </span>
      <% end %>
    </div>
    <p class="mt-0.5 text-sm text-muted-foreground"><%= person.birthday_label %></p>
    <span class="mt-2 inline-flex items-center rounded-full border border-border/60 bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">
      <%= person.department_name %>
    </span>
  </div>

  <% if person.whatsapp_url.present? %>
    <a href="<%= person.whatsapp_url %>" target="_blank" rel="noreferrer"
       aria-label="WhatsApp para <%= person.name %>" title="Enviar mensagem no WhatsApp"
       class="grid h-9 w-9 shrink-0 place-items-center rounded-full text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground">
      <%= lucide_icon("message-circle", class: "h-4 w-4") %>
    </a>
  <% end %>
</div>
