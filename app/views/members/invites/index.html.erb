<% content_for :title, "Convites de Membro" %>

<div class="app-page mx-auto max-w-6xl p-4 sm:p-6 lg:p-12">
  <!-- Header -->
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <%= link_to panel_members_path, class: "inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground" do %>
        <%= lucide_icon("chevron-left", class: "h-4 w-4") %> Membros
      <% end %>
      <h1 class="mt-1 font-serif text-4xl">Convites de Membro</h1>
      <p class="mt-1 text-sm text-muted-foreground">Gere um link para que futuros membros se cadastrem sem precisar ir até a secretaria.</p>
    </div>
    <button type="button"
            class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors cursor-pointer"
            onclick="document.getElementById('modal-new-invite').dispatchEvent(new CustomEvent('modal:open'))">
      <%= lucide_icon("plus", class: "h-4 w-4 mr-2") %> Gerar link
    </button>
  </header>

  <!-- Flash messages -->
  <% if notice.present? %>
    <div class="mt-4 flex items-center gap-3 rounded-xl border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-700 dark:text-green-400">
      <%= lucide_icon("circle-check", class: "h-4 w-4 shrink-0") %>
      <%= notice %>
    </div>
  <% end %>
  <% if alert.present? %>
    <div class="mt-4 flex items-center gap-3 rounded-xl border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive">
      <%= lucide_icon("circle-alert", class: "h-4 w-4 shrink-0") %>
      <%= alert %>
    </div>
  <% end %>

  <!-- Main card -->
  <div class="mt-8 rounded-2xl border border-border/60 bg-card" style="box-shadow: var(--shadow-soft)">
    <div class="overflow-x-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b border-border/60 transition-colors hover:bg-muted/50">
            <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Link</th>
            <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Nota</th>
            <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground hidden md:table-cell">Criado por</th>
            <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground hidden lg:table-cell">Validade</th>
            <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Usos</th>
            <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Status</th>
            <th class="h-10 px-4 text-right align-middle font-medium text-muted-foreground">Ações</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <% if @invites.empty? %>
            <tr>
              <td colspan="7">
                <div class="flex flex-col items-center gap-2 py-12 text-center text-sm text-muted-foreground">
                  <%= lucide_icon("link", class: "h-6 w-6 opacity-50") %>
                  Nenhum convite gerado ainda.
                </div>
              </td>
            </tr>
          <% else %>
            <% @invites.each do |invite| %>
              <% link_url = public_member_invite_url(invite.token) %>
              <tr class="border-b border-border/60 transition-colors hover:bg-muted/30">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2" data-controller="clipboard">
                    <input type="text" readonly value="<%= link_url %>" data-clipboard-target="source"
                           class="w-48 truncate rounded-md border border-input bg-transparent px-2 py-1 text-xs text-muted-foreground">
                    <button type="button" data-action="clipboard#copy"
                            class="inline-flex items-center gap-1 rounded-md border border-border/60 px-2 py-1 text-xs hover:bg-secondary transition-colors cursor-pointer">
                      <%= lucide_icon("clipboard-list", class: "h-3 w-3") %> <span data-clipboard-target="label">Copiar</span>
                    </button>
                  </div>
                </td>
                <td class="px-4 py-3 text-xs text-muted-foreground"><%= invite.note.presence || "—" %></td>
                <td class="hidden px-4 py-3 text-xs text-muted-foreground md:table-cell"><%= invite.created_by.name %></td>
                <td class="hidden px-4 py-3 text-xs text-muted-foreground lg:table-cell"><%= invite.expires_at.strftime("%d/%m/%Y %H:%M") %></td>
                <td class="px-4 py-3 text-xs text-muted-foreground"><%= invite.uses_count %>/<%= invite.max_uses %></td>
                <td class="px-4 py-3">
                  <% if invite.usable? %>
                    <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-700 dark:bg-green-900/30 dark:text-green-400">Ativo</span>
                  <% elsif invite.expired? %>
                    <span class="inline-flex items-center rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-muted-foreground">Expirado</span>
                  <% elsif invite.exhausted? %>
                    <span class="inline-flex items-center rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-muted-foreground">Esgotado</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-muted-foreground">Desativado</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-right">
                  <% if invite.usable? && policy(invite).destroy? %>
                    <%= button_to "Desativar", panel_member_invite_destroy_path(invite), method: :delete,
                          form: { data: { turbo_confirm: "Desativar este link agora?" } },
                          class: "rounded-md border border-destructive/40 px-2 py-1 text-xs font-medium text-destructive hover:bg-destructive/10 transition-colors cursor-pointer" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ── Modal: Gerar link de convite ──────────────────────────────────── -->
<%= render Shared::ModalComponent.new(
      id: "modal-new-invite",
      title: "Convite de Membro",
      description: "Configure a validade e o limite de usos do link de auto-cadastro.",
      size: :md
    ) do |modal| %>
  <% modal.with_body do %>
    <%= form_with url: panel_member_invites_create_path, scope: :member_invite, method: :post, local: true, class: "space-y-4" do |f| %>
      <div class="space-y-2">
        <label for="member_invite_expires_in" class="text-sm font-medium">Validade</label>
        <%= f.select :expires_in,
              options_for_select([
                ["24 horas", "24h"],
                ["3 dias", "3_days"],
                ["7 dias", "7_days"],
                ["15 dias", "15_days"],
                ["30 dias", "30_days"]
              ], "7_days"),
              {},
              id: "member_invite_expires_in",
              class: "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" %>
      </div>

      <div class="space-y-2">
        <label for="member_invite_max_uses" class="text-sm font-medium">Quantidade de usos</label>
        <%= f.number_field :max_uses, id: "member_invite_max_uses", value: 1, min: 1, max: 500,
              class: "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" %>
      </div>

      <div class="space-y-2">
        <label for="member_invite_note" class="text-sm font-medium text-muted-foreground">
          Identificação interna <span class="text-xs font-normal">(opcional)</span>
        </label>
        <%= f.text_field :note, id: "member_invite_note",
              placeholder: "Ex: Link para o retiro de junho",
              class: "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" %>
      </div>

      <div class="flex justify-end gap-3 border-t border-border/40 pt-4">
        <button type="button"
                class="inline-flex items-center justify-center rounded-lg border border-border/60 bg-transparent px-4 py-2 text-sm font-medium text-foreground hover:bg-secondary transition-colors cursor-pointer"
                onclick="document.getElementById('modal-new-invite').dispatchEvent(new CustomEvent('modal:close'))">
          Cancelar
        </button>
        <%= f.submit "Gerar link",
              class: "inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  <% end %>
<% end %>
