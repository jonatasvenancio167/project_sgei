<% content_for :title, "Acolhimento" %>

<%
  filter_params = params.permit(:tab, :q, :type, :service, :start_date, :end_date, :members_only, :page, :per).to_h
  url_builder = ->(page:, per:) do
    panel_welcome_path(filter_params.merge(page: page, per: per))
  end
  can_create = policy(WelcomeRecord).create?
%>

<div class="app-page mx-auto max-w-6xl p-4 sm:p-6 lg:p-12">
  <!-- Header -->
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm text-muted-foreground">Pessoas</p>
      <h1 class="mt-1 flex items-center gap-3 font-serif text-4xl">
        <%= lucide_icon("hand-heart", class: "h-8 w-8 text-primary") %>
        Acolhimento
      </h1>
    </div>
    <% if can_create %>
      <button type="button"
              class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors cursor-pointer"
              onclick="document.getElementById('modal-new-welcome').dispatchEvent(new CustomEvent('modal:open'))">
        <%= lucide_icon("plus", class: "h-4 w-4 mr-2") %> Registrar visita
      </button>
    <% end %>
  </header>

  <!-- Flash messages -->
  <% if notice.present? %>
    <div class="mt-4 flex items-center gap-3 rounded-xl border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-700 dark:text-green-400">
      <%= lucide_icon("circle-check", class: "h-4 w-4 shrink-0") %>
      <%= notice %>
    </div>
  <% end %>
  <% if alert.present? %>
    <div class="mt-4 flex items-center gap-3 rounded-xl border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive">
      <%= lucide_icon("circle-alert", class: "h-4 w-4 shrink-0") %>
      <%= alert %>
    </div>
  <% end %>

  <!-- Abas -->
  <div class="mt-8 flex gap-2 overflow-x-auto pb-1">
    <% @decorator.tab_options.each do |value, label| %>
      <%= link_to label, panel_welcome_path(tab: value), class: @decorator.tab_class(value) %>
    <% end %>
  </div>

  <% if @decorator.tab == "hoje" %>
    <!-- ── Hoje ─────────────────────────────────────────────────────────── -->
    <p class="mt-6 text-sm text-muted-foreground"><%= @decorator.today_summary_text %></p>

    <div class="mt-4">
      <% if @decorator.decorated_records.empty? %>
        <div class="flex flex-col items-center gap-3 rounded-2xl border border-dashed border-border/60 py-16 text-center text-sm text-muted-foreground">
          <%= lucide_icon("hand-heart", class: "h-6 w-6 opacity-50") %>
          Nenhuma visita registrada hoje.
          <% if can_create %>
            <button type="button"
                    class="inline-flex items-center justify-center rounded-lg bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors cursor-pointer"
                    onclick="document.getElementById('modal-new-welcome').dispatchEvent(new CustomEvent('modal:open'))">
              <%= lucide_icon("plus", class: "h-4 w-4 mr-2") %> Registrar visita
            </button>
          <% end %>
        </div>
      <% else %>
        <div class="space-y-3">
          <% @decorator.decorated_records.each do |record| %>
            <%= render "welcome_records/record_card", record: record, filter_params: filter_params %>
          <% end %>
        </div>
        <% if @pagy.pages > 1 %>
          <div class="mt-6 rounded-2xl border border-border/60 bg-card" style="box-shadow: var(--shadow-soft)">
            <%= render Shared::PaginationComponent.new(
                  current_page: @pagy.page,
                  total_pages:  @pagy.pages,
                  total_count:  @pagy.count,
                  page_size:    @pagy.limit,
                  url_builder:  url_builder,
                  item_label:   { singular: "registro", plural: "registros" }
                ) %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <!-- ── Histórico ────────────────────────────────────────────────────── -->
    <div class="mt-6 rounded-2xl border border-border/60 bg-card" style="box-shadow: var(--shadow-soft)">

      <!-- Filtros -->
      <%= form_with url: panel_welcome_path, method: :get, local: true,
                    class: "flex flex-wrap items-center gap-3 border-b border-border/60 p-4" do |f| %>
        <%= f.hidden_field :tab, value: "historico" %>
        <%= f.hidden_field :per, value: @pagy.limit %>

        <!-- Busca por nome -->
        <div class="relative min-w-[200px] flex-1">
          <div class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
            <%= lucide_icon("search", class: "h-4 w-4") %>
          </div>
          <%= f.text_field :q, value: @decorator.current_query,
                placeholder: "Buscar por nome",
                class: "flex h-9 w-full rounded-md border border-input bg-transparent pl-9 pr-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" %>
        </div>

        <!-- Tipo -->
        <%= f.select :type,
              options_for_select(@decorator.type_options, @decorator.current_type),
              {},
              class: "flex h-9 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring w-[150px]" %>

        <!-- Culto -->
        <%= f.select :service,
              options_for_select(@decorator.service_options, @decorator.current_service),
              {},
              class: "flex h-9 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring w-[210px]" %>

        <!-- Período -->
        <div class="flex items-center gap-2">
          <%= f.date_field :start_date, value: @decorator.current_start_date,
                class: "flex h-9 w-[150px] rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" %>
          <span class="text-xs text-muted-foreground">até</span>
          <%= f.date_field :end_date, value: @decorator.current_end_date,
                class: "flex h-9 w-[150px] rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" %>
        </div>

        <!-- Apenas convertidos -->
        <label class="flex items-center gap-2 text-sm cursor-pointer">
          <%= f.check_box :members_only, { checked: @decorator.members_only?, class: "h-4 w-4 rounded border-input accent-[var(--primary)]" }, "1", nil %>
          Apenas convertidos em membros
        </label>

        <button type="submit" class="hidden"></button>

        <% if @decorator.has_active_filters? %>
          <%= link_to panel_welcome_path(tab: "historico"),
                class: "inline-flex items-center gap-1.5 rounded-lg border border-border/60 bg-transparent px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground" do %>
            <%= lucide_icon("x", class: "h-3.5 w-3.5") %> Limpar
          <% end %>
        <% end %>
      <% end %>

      <!-- Auto-submit nos filtros -->
      <script>
        (function() {
          var form = document.querySelector('form[action="<%= panel_welcome_path %>"]');
          if (!form) return;
          form.querySelectorAll('select, input[type=date], input[type=checkbox]').forEach(function(el) {
            el.addEventListener('change', function() { form.submit(); });
          });
        })();
      </script>

      <!-- Tabela -->
      <div class="overflow-x-auto">
        <table class="w-full caption-bottom text-sm">
          <thead class="[&_tr]:border-b">
            <tr class="border-b border-border/60">
              <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Data/hora</th>
              <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Nome</th>
              <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground">Tipo</th>
              <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground hidden md:table-cell">Culto</th>
              <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground hidden lg:table-cell">Congregação</th>
              <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground hidden lg:table-cell">Cidade</th>
              <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground hidden md:table-cell">Telefone</th>
              <th class="h-10 w-[60px] px-4"></th>
            </tr>
          </thead>
          <tbody class="[&_tr:last-child]:border-0">
            <% if @decorator.decorated_records.empty? %>
              <tr>
                <td colspan="8">
                  <div class="flex flex-col items-center gap-2 py-12 text-center text-sm text-muted-foreground">
                    <%= lucide_icon("hand-heart", class: "h-6 w-6 opacity-50") %>
                    Nenhum registro encontrado.
                  </div>
                </td>
              </tr>
            <% else %>
              <% @decorator.decorated_records.each do |record| %>
                <tr class="border-b border-border/60 transition-colors hover:bg-muted/30">
                  <td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground"><%= record.registered_at_label %></td>
                  <td class="px-4 py-3">
                    <div class="flex items-center gap-2">
                      <span class="font-medium"><%= record.name %></span>
                      <% if record.became_member? %>
                        <span class="inline-flex items-center gap-1 rounded-full border border-border/60 bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">
                          <%= lucide_icon("user-check", class: "h-3 w-3") %> Membro
                        </span>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-4 py-3"><span class="<%= record.type_badge_class %>"><%= record.visitor_type_label %></span></td>
                  <td class="hidden px-4 py-3 text-sm md:table-cell"><%= record.service %></td>
                  <td class="hidden px-4 py-3 text-sm text-muted-foreground lg:table-cell"><%= record.congregation.presence || "—" %></td>
                  <td class="hidden px-4 py-3 text-sm text-muted-foreground lg:table-cell"><%= record.city.presence || "—" %></td>
                  <td class="hidden px-4 py-3 md:table-cell">
                    <% if record.whatsapp_url.present? %>
                      <a href="<%= record.whatsapp_url %>" target="_blank" rel="noreferrer"
                         class="inline-flex items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground">
                        <%= lucide_icon("message-circle", class: "h-3.5 w-3.5") %>
                        <%= record.phone %>
                      </a>
                    <% else %>
                      <span class="text-xs text-muted-foreground">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3">
                    <%= render "welcome_records/actions_dropdown", record: record, filter_params: filter_params %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Totais do filtro -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border/60 px-4 py-2 text-xs text-muted-foreground">
        <span><%= @decorator.history_summary_text %></span>
      </div>

      <!-- Paginação -->
      <div class="border-t border-border/60">
        <%= render Shared::PaginationComponent.new(
              current_page: @pagy.page,
              total_pages:  @pagy.pages,
              total_count:  @pagy.count,
              page_size:    @pagy.limit,
              url_builder:  url_builder,
              item_label:   { singular: "registro", plural: "registros" }
            ) %>
      </div>
    </div>
  <% end %>
</div>

<!-- ── Modal: Registrar visita ─────────────────────────────────────────── -->
<% if can_create %>
  <%= render Shared::ModalComponent.new(
        id: "modal-new-welcome",
        title: "Registrar visita",
        description: "Preencha os dados da pessoa acolhida no culto.",
        size: :md
      ) do |modal| %>
    <% modal.with_body do %>
      <%= render "welcome_records/form",
            record: @new_welcome_record,
            url: panel_welcome_create_path,
            method: :post,
            decorator: @decorator,
            field_prefix: "welcome_new",
            registered_at_label: @decorator.now_label,
            filter_params: filter_params %>
    <% end %>
  <% end %>
<% end %>

<!-- ── Modais: Editar registro ─────────────────────────────────────────── -->
<% @decorator.decorated_records.each do |record| %>
  <% next unless policy(record.model).update? %>
  <%= render Shared::ModalComponent.new(
        id: "modal-edit-welcome-#{record.id}",
        title: "Editar registro",
        description: "Atualize os dados de #{record.name}.",
        size: :md
      ) do |modal| %>
    <% modal.with_body do %>
      <%= render "welcome_records/form",
            record: record.model,
            url: panel_welcome_update_path(record.id),
            method: :patch,
            decorator: @decorator,
            field_prefix: "welcome_edit_#{record.id}",
            registered_at_label: record.registered_at_label,
            filter_params: filter_params %>
    <% end %>
  <% end %>
<% end %>
