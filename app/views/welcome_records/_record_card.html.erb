<%# record: WelcomeRecords::RecordDecorator; filter_params: Hash %>
<%# locals: (record:, filter_params:) %>
<div class="rounded-2xl border border-border/60 bg-card p-4" style="box-shadow: var(--shadow-soft)">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <p class="font-medium"><%= record.name %></p>
        <span class="<%= record.type_badge_class %>"><%= record.visitor_type_label %></span>
        <% if record.became_member? %>
          <span class="inline-flex items-center gap-1 rounded-full border border-border/60 bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">
            <%= lucide_icon("user-check", class: "h-3 w-3") %> Membro
          </span>
        <% end %>
      </div>
      <p class="mt-1 text-sm text-muted-foreground"><%= record.service %> · <%= record.time_label %></p>
      <% if record.origin_line.present? %>
        <p class="mt-0.5 text-sm text-muted-foreground"><%= record.origin_line %></p>
      <% end %>
      <% if record.notes.present? %>
        <p class="mt-2 rounded-lg bg-secondary/50 px-3 py-2 text-xs text-muted-foreground"><%= record.notes %></p>
      <% end %>
    </div>
    <div class="flex items-center gap-1">
      <% if record.whatsapp_url.present? %>
        <a href="<%= record.whatsapp_url %>" target="_blank" rel="noreferrer"
           aria-label="WhatsApp para <%= record.name %>" title="Enviar mensagem no WhatsApp"
           class="grid h-9 w-9 place-items-center rounded-full text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground">
          <%= lucide_icon("message-circle", class: "h-4 w-4") %>
        </a>
      <% end %>
      <%= render "welcome_records/actions_dropdown", record: record, filter_params: filter_params %>
    </div>
  </div>
</div>
