<article class="flex flex-col overflow-hidden rounded-2xl border border-border/60 bg-card shadow-sm"
         style="box-shadow: var(--shadow-soft)">
  <div class="h-2 w-full <%= schedule.color_bar_class %>"></div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-2">
      <div>
        <h3 class="font-serif text-xl"><%= schedule.name %></h3>
        <p class="text-xs text-muted-foreground">
          Departamento · <%= schedule.department_name %>
        </p>
      </div>
      <div class="flex items-center gap-1">
        <span class="inline-grid h-9 w-9 shrink-0 place-items-center rounded-lg text-primary-foreground <%= schedule.color %>">
          <%= lucide_icon("calendar-range", class: "h-4 w-4") %>
        </span>
        <div class="relative" data-controller="dropdown">
          <button type="button"
                  class="inline-grid h-9 w-9 shrink-0 place-items-center rounded-lg text-muted-foreground hover:bg-secondary transition-colors cursor-pointer"
                  data-action="click->dropdown#toggle"
                  aria-label="Opções">
            <%= lucide_icon("ellipsis-vertical", class: "h-4 w-4") %>
          </button>
          <div class="hidden absolute right-0 top-full mt-1 z-20 min-w-[140px] overflow-hidden rounded-lg border border-border/60 bg-card shadow-lg"
               data-dropdown-target="menu">
            <button type="button"
                    class="flex w-full items-center gap-2 px-3 py-2 text-sm hover:bg-secondary transition-colors cursor-pointer"
                    onclick="this.closest('[data-controller=dropdown]').querySelector('[data-dropdown-target=menu]').classList.add('hidden'); document.getElementById('modal-edit-schedule-<%= schedule.id %>').dispatchEvent(new CustomEvent('modal:open'))">
              <%= lucide_icon("pencil", class: "h-4 w-4 text-muted-foreground") %>
              Editar
            </button>
            <%= form_with url: panel_schedule_destroy_path(schedule.id), method: :delete, local: true do %>
              <button type="submit"
                      onclick="return confirm('Tem certeza que deseja excluir a escala \"<%= schedule.name %>\"?')"
                      class="flex w-full items-center gap-2 px-3 py-2 text-sm text-destructive hover:bg-destructive/10 transition-colors cursor-pointer">
                <%= lucide_icon("trash-2", class: "h-4 w-4") %>
                Excluir
              </button>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <p class="text-sm text-muted-foreground">
      <%= schedule.columns_count_label %> · <%= schedule.columns_preview %>
    </p>
    <div class="mt-auto pt-2">
      <%= link_to schedule.month_path,
                  class: "inline-flex w-full items-center justify-center rounded-lg bg-secondary px-4 py-2 text-sm font-medium text-secondary-foreground hover:bg-secondary/80 transition-colors no-underline" do %>
        Ver escala do mês <%= lucide_icon("arrow-right", class: "ml-1 h-4 w-4") %>
      <% end %>
    </div>
  </div>
</article>

<%= render Shared::ModalComponent.new(id: "modal-edit-schedule-#{schedule.id}", title: "Editar escala", description: "Altere os dados desta escala.", size: :lg) do |modal| %>
  <% modal.with_body do %>
    <%= render "schedules/form", schedule: schedule, decorator: @decorator %>
  <% end %>
<% end %>
