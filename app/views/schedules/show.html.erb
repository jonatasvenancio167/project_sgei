<% content_for :title, @schedule.name %>

<div class="mx-auto max-w-6xl p-6 lg:p-10">
  <!-- Header -->
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <%= link_to painel_schedules_path,
                  class: "inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors no-underline group" do %>
        <%= lucide_icon("arrow-left", class: "h-4 w-4 transition-transform group-hover:-translate-x-0.5") %>
        Escalas
      <% end %>
      <p class="mt-0.5 flex items-center gap-1.5 text-xs text-muted-foreground/60">
        <span><%= month_label(@month) %></span>
      </p>
      <h1 class="mt-1 font-serif text-4xl"><%= @schedule.name %></h1>
      <p class="mt-2 text-sm text-muted-foreground">
        Departamento · <%= @decorator.department_name %>
      </p>
    </div>

    <div class="flex flex-col items-end gap-3">
      <span class="inline-grid h-11 w-11 place-items-center rounded-xl text-primary-foreground <%= @schedule.color %> shadow-sm">
        <%= lucide_icon("calendar-range", class: "h-5 w-5") %>
      </span>
      <!-- Navegação de mês -->
      <div class="flex items-center gap-1">
        <%= link_to painel_schedule_month_path(@schedule, month: previous_month(@month)),
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border/60 text-muted-foreground hover:bg-secondary transition-colors" do %>
          <%= lucide_icon("chevron-left", class: "h-4 w-4") %>
        <% end %>
        <span class="min-w-[120px] text-center text-sm font-medium"><%= month_label(@month) %></span>
        <%= link_to painel_schedule_month_path(@schedule, month: next_month(@month)),
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border/60 text-muted-foreground hover:bg-secondary transition-colors" do %>
          <%= lucide_icon("chevron-right", class: "h-4 w-4") %>
        <% end %>
      </div>
    </div>
  </header>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_260px]">
    <!-- Grade da escala -->
    <div class="space-y-4">
      <% if @entries.any? %>
        <div class="overflow-x-auto overflow-hidden rounded-2xl border border-border/60 bg-card shadow-sm" style="box-shadow: var(--shadow-soft)">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border/60 bg-secondary/40">
                <th class="whitespace-nowrap px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-muted-foreground">
                  Data
                </th>
                <% @columns.each do |column| %>
                  <th class="whitespace-nowrap px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-muted-foreground">
                    <%= column.name %>
                  </th>
                <% end %>
                <th class="w-10 px-2"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/40">
              <% @entries.each do |entry| %>
                <tr class="hover:bg-secondary/20 transition-colors">
                  <td class="whitespace-nowrap px-4 py-3 text-sm font-medium">
                    <%= date_label(entry.date) %>
                  </td>
                  <% @columns.each do |column| %>
                    <td class="px-4 py-3 text-sm">
                      <%= render_cell_value(column, entry.cell_values[column.id.to_s], @users_map) %>
                    </td>
                  <% end %>
                  <td class="px-2 py-3">
                    <%= form_with url: painel_schedule_entry_destroy_path(@schedule, entry), method: :delete, local: true do %>
                      <input type="hidden" name="month" value="<%= @month %>" />
                      <button type="submit"
                              onclick="return confirm('Remover esta linha?')"
                              class="inline-flex items-center justify-center rounded-lg p-1.5 text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition-colors cursor-pointer">
                        <%= lucide_icon("trash-2", class: "h-4 w-4") %>
                      </button>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="rounded-2xl border border-dashed border-border/60 bg-card/40 p-12 text-center">
          <%= lucide_icon("calendar-plus", class: "mx-auto mb-3 h-10 w-10 text-muted-foreground/50") %>
          <p class="text-sm font-medium text-muted-foreground">Nenhuma entrada neste mês.</p>
          <p class="mt-1 text-xs text-muted-foreground/70">Clique em "Adicionar linha" para começar.</p>
        </div>
      <% end %>

      <button type="button"
              class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors cursor-pointer"
              onclick="document.getElementById('modal-new-entry').dispatchEvent(new CustomEvent('modal:open'))">
        <%= lucide_icon("plus", class: "h-4 w-4") %>
        Adicionar linha
      </button>
    </div>

    <!-- Painel de membros -->
    <aside class="space-y-4">
        <!-- Escalados -->
        <div class="rounded-2xl border border-border/60 bg-card p-5 shadow-sm" style="box-shadow: var(--shadow-soft)">
          <h3 class="mb-3 text-sm font-semibold">Neste mês</h3>
          <% if @scheduled_members.any? %>
            <ul class="space-y-2.5">
              <% @scheduled_members.each do |member| %>
                <li class="flex items-center gap-2.5 text-sm">
                  <span class="inline-grid h-5 w-5 shrink-0 place-items-center rounded-full bg-emerald-100 text-emerald-600 dark:bg-emerald-900/40 dark:text-emerald-400">
                    <%= lucide_icon("check", class: "h-3 w-3") %>
                  </span>
                  <span class="min-w-0 flex-1 truncate"><%= member.name %></span>
                  <span class="shrink-0 text-xs text-muted-foreground"><%= @member_counts[member.id.to_s] %>×</span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-xs text-muted-foreground">Nenhum membro escalado ainda.</p>
          <% end %>
        </div>

        <!-- Fora da escala -->
        <% if @unscheduled_members.any? %>
          <div class="rounded-2xl border border-border/60 bg-card p-5 shadow-sm" style="box-shadow: var(--shadow-soft)">
            <h3 class="mb-3 text-sm font-semibold text-muted-foreground">Fora da escala</h3>
            <ul class="space-y-2.5">
              <% @unscheduled_members.each do |member| %>
                <li class="flex items-center gap-2.5 text-sm text-muted-foreground">
                  <span class="inline-grid h-5 w-5 shrink-0 place-items-center rounded-full bg-secondary text-muted-foreground/50">
                    <%= lucide_icon("minus", class: "h-3 w-3") %>
                  </span>
                  <span class="min-w-0 truncate"><%= member.name %></span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
    </aside>
  </div>
</div>

<!-- Modal: nova entrada -->
<%= render Shared::ModalComponent.new(id: "modal-new-entry", title: "Nova entrada", size: :md) do |modal| %>
  <% modal.with_body do %>
    <%= render "schedules/entry_form",
               schedule: @schedule,
               month: @month,
               columns: @columns,
               members: @dept_members %>
  <% end %>
<% end %>
