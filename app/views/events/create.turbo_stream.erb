<%= turbo_stream.append "events_table_body" do %>
  <%= render partial: "events/event_row", locals: { event: EventDecorator.new(@event, self) } %>
<% end %>


<%= turbo_stream.replace "new_event_form" do %>
  <%= render partial: "events/form", locals: { event: Event.new } %>
<% end %>

<%= turbo_stream.append "modal-new-event" do %>
  <div data-controller="close-modal" data-close-modal-modal-id-value="modal-new-event"></div>
<% end %>
