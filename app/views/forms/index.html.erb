<% content_for :title, "Formulários" %>

<%
  url_builder = ->(page:, per:) do
    forms_path(params.to_unsafe_h.merge(page: page, per: per))
  end
%>

<div class="mx-auto max-w-6xl p-8 lg:p-12">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm text-muted-foreground">Inscrições</p>
      <h1 class="mt-1 font-serif text-4xl">Formulários</h1>
      <% if current_user.admin? %>
        <p class="mt-2 text-sm text-muted-foreground">
          Crie formulários de inscrição, envie convites por e-mail e acompanhe os inscritos em tempo real.
        </p>
      <% elsif current_user.leader? %>
        <p class="mt-2 text-sm text-muted-foreground">
          Formulários do departamento <span class="font-medium text-foreground"><%= current_user.primary_department_name %></span> e da igreja (Geral).
        </p>
      <% end %>
    </div>

    <% if current_user.admin? || current_user.leader? %>
      <%= link_to new_form_path,
            class: "inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground ring-offset-background transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus mr-1 h-4 w-4"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Novo formulário
      <% end %>
    <% end %>
  </header>

  <% if @forms.empty? %>
    <div class="mt-12 flex flex-col items-center justify-center gap-3 py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list h-12 w-12 opacity-20"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
      <p class="text-base font-medium text-muted-foreground">Nenhum formulário disponível para o seu perfil.</p>
      <% if current_user.admin? || current_user.leader? %>
        <%= link_to new_form_path,
              class: "mt-2 inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus mr-1 h-4 w-4"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          Criar primeiro formulário
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      <% @forms.each do |form| %>
        <div class="group rounded-2xl border border-border/60 bg-card p-6" style="box-shadow: var(--shadow-soft)">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-serif text-xl leading-snug"><%= form.title %></h3>
            <span class="shrink-0 rounded-full px-2.5 py-0.5 text-[11px] font-medium <%= form.active? ? 'bg-primary/15 text-primary' : 'bg-muted text-muted-foreground' %>">
              <%= form.status_label %>
            </span>
          </div>

          <% if form.departament.present? %>
            <p class="mt-1 text-xs text-muted-foreground"><%= form.departament.name %></p>
          <% else %>
            <p class="mt-1 text-xs text-muted-foreground">Geral</p>
          <% end %>

          <% subs = form.responses_count %>
          <% if form.limit.present? %>
            <p class="mt-3 text-sm text-muted-foreground"><%= subs %> de <%= form.limit %> inscritos</p>
            <div class="mt-2 h-2 overflow-hidden rounded-full bg-secondary">
              <div class="h-full rounded-full bg-primary transition-all" style="width: <%= form.fill_percentage %>%"></div>
            </div>
          <% else %>
            <p class="mt-3 text-sm text-muted-foreground"><%= subs %> <%= subs == 1 ? "inscrito" : "inscritos" %></p>
            <div class="mt-2 h-2 rounded-full bg-secondary"></div>
          <% end %>

          <div class="mt-5 flex items-center justify-between">
            <% if current_user.admin? || current_user.leader? %>
              <%= link_to edit_form_path(form),
                    class: "inline-flex items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil h-3.5 w-3.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                Editar
              <% end %>
            <% else %>
              <span></span>
            <% end %>

            <%= link_to form_path(form),
                  class: "inline-flex items-center text-sm font-medium text-primary hover:underline" do %>
              Ver inscritos
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-1 h-3.5 w-3.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6 overflow-hidden rounded-2xl border border-border/60 bg-card" style="box-shadow: var(--shadow-soft)">
      <%= render Shared::PaginationComponent.new(
            current_page: @pagy.page,
            total_pages:  @pagy.pages,
            total_count:  @pagy.count,
            page_size:    @pagy.limit,
            url_builder:  url_builder,
            item_label:   { singular: "formulário", plural: "formulários" }
          ) %>
    </div>
  <% end %>
</div>
