<% content_for :title, "Cadastro de membro – #{@invite.church.display_name_or_default}" %>

<div class="min-h-screen bg-secondary/30 pb-16">
  <div class="h-3 w-full bg-primary"></div>

  <div class="mx-auto max-w-xl px-4 pt-8">
    <!-- Church header -->
    <div class="flex flex-col items-center text-center">
      <% if @invite.church.logo.attached? %>
        <%= image_tag @invite.church.logo, class: "h-16 w-16 rounded-full object-cover shadow-sm" %>
      <% end %>
      <h1 class="mt-3 font-serif text-2xl"><%= @invite.church.display_name_or_default %></h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Preencha as informações abaixo para se cadastrar como membro de <%= @invite.church.display_name_or_default %>.
      </p>
    </div>

    <% if @user.errors.any? %>
      <div class="mt-4 flex items-center gap-3 rounded-xl border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive">
        <%= lucide_icon("circle-alert", class: "h-4 w-4 shrink-0") %>
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%= form_with url: public_member_invite_submit_path(@invite.token), scope: :user, method: :post, class: "mt-4 space-y-4" do |f| %>
      <div class="rounded-2xl border border-border/60 bg-card p-6 shadow-sm space-y-4">
        <div class="grid gap-1.5">
          <label class="text-sm font-medium">Nome completo *</label>
          <%= f.text_field :name, required: true, value: @user.name,
                class: "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring",
                placeholder: "Seu nome" %>
        </div>

        <div class="grid gap-1.5">
          <label class="text-sm font-medium">Telefone / WhatsApp *</label>
          <%= f.text_field :phone, required: true, value: @user.phone, maxlength: 15,
                data: { controller: "phone-mask", action: "input->phone-mask#mask", "phone-mask-target" => "input" },
                class: "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring",
                placeholder: "(00) 00000-0000" %>
        </div>

        <div class="grid gap-1.5">
          <label class="text-sm font-medium">E-mail <span class="font-normal text-muted-foreground">(opcional)</span></label>
          <%= f.email_field :email, value: @user.email,
                class: "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring",
                placeholder: "seu@email.com" %>
        </div>

        <div class="grid gap-1.5">
          <label class="text-sm font-medium">Data de nascimento <span class="font-normal text-muted-foreground">(opcional)</span></label>
          <%= f.date_field :birth_date, value: @user.birth_date, max: Date.current,
                class: "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-ring" %>
        </div>

        <div class="grid gap-1.5">
          <label class="text-sm font-medium">Senha *</label>
          <div class="relative" data-controller="password-toggle">
            <%= f.password_field :password, required: true, minlength: 6, autocomplete: "new-password",
                  data: { "password-toggle-target" => "input" },
                  class: "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 pr-10 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring",
                  placeholder: "Mínimo de 6 caracteres" %>
            <button type="button"
                    class="absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground hover:text-foreground"
                    data-action="password-toggle#toggle" aria-label="Mostrar senha">
              <span data-password-toggle-target="eyeIcon"><%= lucide_icon("eye", class: "h-4 w-4") %></span>
              <span data-password-toggle-target="eyeOffIcon" class="hidden"><%= lucide_icon("eye-off", class: "h-4 w-4") %></span>
            </button>
          </div>
        </div>

        <div class="grid gap-1.5">
          <label class="text-sm font-medium">Confirmar senha *</label>
          <div class="relative" data-controller="password-toggle">
            <%= f.password_field :password_confirmation, required: true, minlength: 6, autocomplete: "new-password",
                  data: { "password-toggle-target" => "input" },
                  class: "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 pr-10 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring",
                  placeholder: "Repita a senha" %>
            <button type="button"
                    class="absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground hover:text-foreground"
                    data-action="password-toggle#toggle" aria-label="Mostrar senha">
              <span data-password-toggle-target="eyeIcon"><%= lucide_icon("eye", class: "h-4 w-4") %></span>
              <span data-password-toggle-target="eyeOffIcon" class="hidden"><%= lucide_icon("eye-off", class: "h-4 w-4") %></span>
            </button>
          </div>
        </div>
      </div>

      <button type="submit"
              class="inline-flex w-full items-center justify-center rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring">
        Enviar cadastro
      </button>
    <% end %>
  </div>
</div>
